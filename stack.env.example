# Vorlage für die Umgebungsvariablen in Portainer
# (Portainer: Stack -> "Environment variables" -> "Advanced mode" -> hier einfügen)

# Pflicht: Hostname=Ziel, mehrere durch Komma getrennt. Optionen: |auth |lan
SERVICES=ha.meinhaus.duckdns.org=http://192.168.178.10:8123,nodered.meinhaus.duckdns.org=http://192.168.178.10:1880|auth,z2m.meinhaus.duckdns.org=http://192.168.178.10:8080|auth|lan

# Empfohlen: Mail für den Let's-Encrypt-Account
LE_EMAIL=

# 1 = Test-Zertifikate (nicht vertrauenswürdig, aber keine Rate-Limits). Erst testen, dann auf 0.
LE_STAGING=0

# Benutzer für Dienste mit |auth  (user:passwort, mehrere durch Komma)
BASIC_AUTH_USERS=admin:BitteEinLangesPasswortWaehlen

# Heimnetz für Dienste mit |lan
LAN_CIDRS=192.168.178.0/24 fc00::/7

TZ=Europe/Berlin
